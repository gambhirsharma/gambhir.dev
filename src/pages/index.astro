---
import LocationMap from '@/components/LocationMap.vue'
import BirthdayBalloons from '@/components/BirthdayBalloons.vue'
import TrekStats from '@/components/TrekStats.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import siteConfig from '@/site-config'
import { HomeData } from '@/content/websiteData'
import mapLocations from '@/data/map-locations'
import treks from '@/data/treks'
import { buildTrekRoutes, getTrekStats } from '@/utils/treks'
import reading from '@/data/reading'

const trekRoutes = buildTrekRoutes(treks)
const trekStats = getTrekStats(trekRoutes)
const currentlyReading = reading.filter((x) => x.status === 'reading').slice(0, 3)

// 2025-09-01 -> 2025.09
const fmtMonth = (d: Date | 'present') => (d === 'present' ? 'present' : d.toISOString().slice(0, 7).replace('-', '.'))
---

<BaseLayout description={siteConfig.description}>
  <BirthdayBalloons client:load birthday={siteConfig.birthday} />
  <article class="home">
    <Hero />

    <div class="bio">
      <p>
        undergrad student at <a target="_blank" href="https://en.wikipedia.org/wiki/University_of_Rome_Tor_Vergata"
          >tor vergata</a
        > with a passion to build stuff, & strong advocate for free open-source software. finished internship at <a
          target="_blank"
          href="https://www.cgi.com/en">CGI</a
        > as devops eng scaling earth observatory <a target="_blank" href="https://insula.earth">insula.earth</a> at CGI,
        frascati. btw i use neovim & here is <a target="_blank" href="https://github.com/gambhirsharma/nvim"
          >my config</a
        >
      </p>
      <p>
        currently working on a distributed edge object detection system for <a
          target="_blank"
          href="https://www.ericsson.com/en/6g/isac">ISAC 6G</a
        > networks using KubeEdge.
      </p>
    </div>

    <div class="treks">
      <div class="map-container">
        <LocationMap
          client:only="vue"
          currentLocation={mapLocations.currentLocation}
          places={mapLocations.places}
          treks={trekRoutes}
          zoom={5}
        />
      </div>
      <TrekStats stats={trekStats} href="/treks" />
    </div>

    {
      HomeData.work.length > 0 && (
        <section class="block">
          <div class="block-head">
            <h2>work</h2>
            <span class="pill">
              <span class="pill-dot" />
              OPEN TO WORK
            </span>
          </div>
          {HomeData.work.map((x) => (
            <div class="row">
              <div class="row-title">
                {x.title} <span>· {x.position}</span>
              </div>
              <div class="row-aside">
                {fmtMonth(x.duration.start)} – {fmtMonth(x.duration.end)}
              </div>
              <div class="row-desc">{x.description}</div>
            </div>
          ))}
        </section>
      )
    }

    {
      HomeData.project.length > 0 && (
        <section class="block">
          <div class="block-head">
            <h2>projects</h2>
            <a class="more" href="/projects">
              all projects ↗
            </a>
          </div>
          {HomeData.project.map((x) => (
            <a class="project" href={x.url} target="_blank">
              <div class="project-head">
                <span class="row-title">{x.title}</span>
                <span class="project-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div class="row-desc">{x.description}</div>
              <div class="chips">
                {x.techstack.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </a>
          ))}
        </section>
      )
    }

    {
      currentlyReading.length > 0 && (
        <section class="block">
          <div class="block-head">
            <h2>reading</h2>
            <a class="more" href="/blog/papers">
              reading list ↗
            </a>
          </div>
          {currentlyReading.map((x) => (
            <div class="row">
              <a class="reading-title" href={x.url} target="_blank">
                {x.title}
              </a>
              <div class="row-aside">{x.year}</div>
              <div class="reading-meta">
                {[x.kind, x.authors].filter(Boolean).join(' · ')}
                {x.note && (
                  <>
                    {' · '}
                    <a href={`/posts/${x.note}`}>notes</a>
                  </>
                )}
              </div>
            </div>
          ))}
        </section>
      )
    }

    <section class="contact">
      <div class="contact-body">
        <h2>let's talk</h2>
        <p>devops, platform &amp; distributed systems roles. or just say hi.</p>
        <a class="btn btn-primary contact-cta" href={`mailto:${siteConfig.email}`}>
          {siteConfig.emailDisplay}
          <span aria-hidden="true">→</span>
        </a>
        <div class="contact-links">
          {
            siteConfig.socialLinks.map((link) => (
              <a href={link.href} target="_blank">
                {link.text} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="contact-art" aria-hidden="true">
        <span class="art-status"><span class="art-dot"></span>available now</span>
        <span class="art-word">open<br />to work</span>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#banana-trigger')
  const requiredClicks = 8
  const maxClickGap = 400
  let clicks = 0
  let lastClick = 0
  let celebrating = false

  interface Banana {
    x: number
    y: number
    px: number
    py: number
    r: number
    angle: number
    spin: number
    rest: number
    still: number
    frozen: boolean
    touching: boolean
  }

  const step = 1 / 120
  const gravity = 2400
  const solverIterations = 6

  interface Sound {
    context: AudioContext
    buffer: Promise<AudioBuffer | null>
  }

  const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms))

  function loadSound(): Sound | null {
    const AudioContext = window.AudioContext || window.webkitAudioContext
    if (!AudioContext) {
      return null
    }
    // created inside the click so browsers allow it to play later
    const context = new AudioContext()
    void context.resume()
    const buffer = fetch('/game-over.mp3')
      .then((response) => response.arrayBuffer())
      .then((data) => context.decodeAudioData(data))
      .catch(() => null)
    return { context, buffer }
  }

  // resolves once the sound has finished, so the pile can stay until then
  async function playGameOver(sound: Sound | null) {
    const buffer = await sound?.buffer
    if (!sound || !buffer) {
      void sound?.context.close()
      await wait(1500)
      return
    }
    const source = sound.context.createBufferSource()
    source.buffer = buffer
    source.connect(sound.context.destination)
    const ended = new Promise((resolve) => source.addEventListener('ended', resolve))
    source.start()
    // in case playback is blocked and `ended` never fires
    await Promise.race([ended, wait(buffer.duration * 1000 + 300)])
    void sound.context.close()
  }

  // freeze the page where it is while bananas are on screen; returns the undo
  function lockScroll() {
    const root = document.documentElement
    const body = document.body
    const scrollbar = window.innerWidth - root.clientWidth
    const previous = {
      rootOverflow: root.style.overflow,
      bodyOverflow: body.style.overflow,
      paddingRight: body.style.paddingRight,
    }
    root.style.overflow = 'hidden'
    body.style.overflow = 'hidden'
    // keep the layout from jumping when the scrollbar disappears
    body.style.paddingRight = `${scrollbar}px`
    const block = (event: Event) => event.preventDefault()
    window.addEventListener('wheel', block, { passive: false })
    window.addEventListener('touchmove', block, { passive: false })
    return () => {
      root.style.overflow = previous.rootOverflow
      body.style.overflow = previous.bodyOverflow
      body.style.paddingRight = previous.paddingRight
      window.removeEventListener('wheel', block)
      window.removeEventListener('touchmove', block)
    }
  }

  function rasterise(image: HTMLImageElement, size: number, shade = 0) {
    const sprite = document.createElement('canvas')
    sprite.width = size
    sprite.height = size
    const context = sprite.getContext('2d')!
    // fit inside the square without squashing the icon
    const scale = size / Math.max(image.naturalWidth, image.naturalHeight)
    const w = image.naturalWidth * scale
    const h = image.naturalHeight * scale
    context.drawImage(image, (size - w) / 2, (size - h) / 2, w, h)
    if (shade) {
      context.globalCompositeOperation = 'source-atop'
      context.fillStyle = `rgb(150 95 0 / ${shade})`
      context.fillRect(0, 0, size, size)
    }
    return sprite
  }

  async function startBananaRain() {
    if (celebrating) {
      return
    }
    celebrating = true
    const sound = loadSound()

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      void playGameOver(sound)
      celebrating = false
      return
    }

    const image = new Image()
    image.src = '/kela.svg'
    const loaded = await image.decode().then(
      () => true,
      () => false,
    )
    if (!loaded) {
      void sound?.context.close()
      celebrating = false
      return
    }
    const canvas = document.createElement('canvas')
    canvas.className = 'banana-rain'
    canvas.setAttribute('aria-hidden', 'true')
    document.body.append(canvas)
    const unlockScroll = lockScroll()
    const context = canvas.getContext('2d')!
    // settled bananas are painted once onto this layer instead of every frame
    const pile = document.createElement('canvas')
    const pileContext = pile.getContext('2d')!
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    let width = 0
    let height = 0

    // size bananas so roughly a thousand bury the viewport (random circle packing is ~85% dense)
    const area = window.innerWidth * window.innerHeight
    let radius = Math.min(28, Math.max(13, Math.min(window.innerWidth, window.innerHeight) / 26))
    radius = Math.max(radius, Math.sqrt(area / (Math.PI * 0.85 * 1100)))
    const estimate = area / (Math.PI * radius * radius * 0.85)
    const spawnRate = estimate / 4.5
    const maxBananas = estimate * 2.5

    // pre-rendered at on-screen size so each frame is just cheap blits
    const sprite = rasterise(image, Math.ceil(radius * 3.4 * dpr))
    const shadedSprite = rasterise(image, Math.ceil(radius * 3.6 * dpr), 0.3)
    const bananas: Banana[] = []
    function resize() {
      width = window.innerWidth
      height = window.innerHeight
      canvas.width = pile.width = width * dpr
      canvas.height = pile.height = height * dpr
      bananas.filter((banana) => banana.frozen).forEach(paintIntoPile)
    }
    resize()
    window.addEventListener('resize', resize)
    const grid = new Map<number, number[]>()
    const cell = radius * 2.4
    let phase: 'raining' | 'full' | 'draining' = 'raining'
    let phaseTime = 0
    let soundFinished = false
    let spawnBudget = 0
    let elapsed = 0
    let accumulator = 0
    let lastFrame = performance.now()

    // good enough once the resting pile covers most of the screen; a few air pockets are fine
    function isBuried() {
      const columns = Array.from({ length: Math.ceil(width / cell) }, () => Infinity)
      for (const banana of bananas) {
        if (banana.rest >= 1) {
          const column = Math.min(columns.length - 1, Math.floor(banana.x / cell))
          columns[column] = Math.min(columns[column], banana.y)
        }
      }
      const filled = columns.reduce((sum, top) => sum + Math.min(1, Math.max(0, (height - top) / height)), 0)
      return filled / columns.length >= 0.9
    }

    function spawn(pileTop: number) {
      const r = radius * (0.8 + Math.random() * 0.4)
      const x = r + Math.random() * (width - 2 * r)
      const y = Math.min(-r, pileTop - 2 * r) - Math.random() * height * 0.3
      const vx = (Math.random() - 0.5) * 160
      const vy = 150 + Math.random() * 450
      bananas.push({
        x,
        y,
        px: x - vx * step,
        py: y - vy * step,
        r,
        angle: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 12,
        rest: 0,
        still: 0,
        frozen: false,
        touching: false,
      })
    }

    function collide() {
      grid.clear()
      bananas.forEach((banana, index) => {
        const key = Math.floor(banana.y / cell) * 4096 + Math.floor(banana.x / cell)
        const bucket = grid.get(key) ?? []
        bucket.push(index)
        grid.set(key, bucket)
      })
      for (let i = 0; i < bananas.length; i++) {
        const a = bananas[i]
        const gx = Math.floor(a.x / cell)
        const gy = Math.floor(a.y / cell)
        for (let dy = -1; dy <= 1; dy++) {
          for (let dx = -1; dx <= 1; dx++) {
            const bucket = grid.get((gy + dy) * 4096 + gx + dx)
            if (!bucket) {
              continue
            }
            for (const j of bucket) {
              if (j <= i) {
                continue
              }
              const b = bananas[j]
              if (a.frozen && b.frozen) {
                continue
              }
              const nx = b.x - a.x
              const ny = b.y - a.y
              const min = a.r + b.r
              const distSq = nx * nx + ny * ny
              if (distSq >= min * min || distSq === 0) {
                continue
              }
              const dist = Math.sqrt(distSq)
              const overlap = (min - dist) / dist
              // frozen bananas are immovable, so a falling one takes the whole push
              const massA = a.frozen ? Infinity : a.r * a.r
              const massB = b.frozen ? Infinity : b.r * b.r
              const shareA = a.frozen ? 0 : b.frozen ? 1 : massB / (massA + massB)
              const shareB = 1 - shareA
              a.x -= nx * overlap * shareA
              a.y -= ny * overlap * shareA
              b.x += nx * overlap * shareB
              b.y += ny * overlap * shareB
              a.touching = true
              b.touching = true
            }
          }
        }
      }
    }

    function simulate() {
      for (const banana of bananas) {
        if (banana.frozen) {
          continue
        }
        // verlet integration: velocity is implied by the previous position
        const vx = (banana.x - banana.px) * 0.998
        const vy = (banana.y - banana.py) * 0.998
        banana.px = banana.x
        banana.py = banana.y
        banana.x += vx
        banana.y += vy + gravity * step * step
        banana.touching = false
      }

      for (let iteration = 0; iteration < solverIterations; iteration++) {
        collide()
        for (const banana of bananas) {
          if (banana.frozen) {
            continue
          }
          const wallX = Math.min(width - banana.r, Math.max(banana.r, banana.x))
          if (wallX !== banana.x) {
            banana.x = wallX
            banana.touching = true
          }
          if (phase !== 'draining' && banana.y > height - banana.r) {
            banana.y = height - banana.r
            // floor friction
            banana.px = banana.x - (banana.x - banana.px) * 0.85
            banana.touching = true
          }
        }
      }

      for (const banana of bananas) {
        if (banana.frozen) {
          continue
        }
        if (banana.touching) {
          // roll along with the pile
          const rolling = (banana.x - banana.px) / step / banana.r
          banana.spin += (rolling - banana.spin) * 0.25
        }
        banana.angle += banana.spin * step
        banana.rest = Math.min(1, Math.max(0, banana.rest + (banana.touching ? 3 : -3) * step))

        const speed = Math.hypot(banana.x - banana.px, banana.y - banana.py) / step
        banana.still = phase !== 'draining' && banana.rest >= 1 && speed < 20 ? banana.still + step : 0
        if (banana.still > 0.4) {
          banana.frozen = true
          paintIntoPile(banana)
        }
      }
    }

    function drawSprite(
      target: CanvasRenderingContext2D,
      image: HTMLCanvasElement,
      banana: Banana,
      angle: number,
      size: number,
    ) {
      const cos = Math.cos(angle) * dpr
      const sin = Math.sin(angle) * dpr
      target.setTransform(cos, sin, -sin, cos, banana.x * dpr, banana.y * dpr)
      target.drawImage(image, -size / 2, -size / 2, size, size)
    }

    function paintIntoPile(banana: Banana) {
      pileContext.globalCompositeOperation = 'source-over'
      drawSprite(pileContext, sprite, banana, banana.angle, banana.r * 3.4)
      // shade and gap filler go behind everything already in the pile
      pileContext.globalCompositeOperation = 'destination-over'
      drawSprite(pileContext, shadedSprite, banana, banana.angle + 2.1, banana.r * 3.6)
      pileContext.setTransform(dpr, 0, 0, dpr, 0, 0)
      pileContext.fillStyle = '#d9a21a'
      pileContext.beginPath()
      pileContext.arc(banana.x, banana.y, banana.r * 1.5, 0, Math.PI * 2)
      pileContext.fill()
    }

    function draw() {
      context.setTransform(1, 0, 0, 1, 0, 0)
      context.clearRect(0, 0, canvas.width, canvas.height)
      if (phase !== 'draining') {
        context.drawImage(pile, 0, 0)
        context.setTransform(dpr, 0, 0, dpr, 0, 0)
        for (const banana of bananas) {
          if (!banana.frozen && banana.y + banana.r * 2 > 0) {
            context.globalAlpha = banana.rest
            drawSprite(context, shadedSprite, banana, banana.angle + 2.1, banana.r * 3.6)
            context.globalAlpha = 1
            drawSprite(context, sprite, banana, banana.angle, banana.r * 3.4)
          }
        }
        return
      }

      const visible = bananas.filter((banana) => banana.y + banana.r * 2 > 0 && banana.y - banana.r * 2 < height)

      // the deep, shadowed part of the pile fills the gaps so nothing shows through
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      context.fillStyle = '#d9a21a'
      context.beginPath()
      for (const banana of visible) {
        if (banana.rest >= 1) {
          context.moveTo(banana.x + banana.r * 1.5, banana.y)
          context.arc(banana.x, banana.y, banana.r * 1.5, 0, Math.PI * 2)
        }
      }
      context.fill()
      for (const banana of visible) {
        if (banana.rest > 0) {
          context.globalAlpha = banana.rest
          drawSprite(context, shadedSprite, banana, banana.angle + 2.1, banana.r * 3.6)
        }
      }
      context.globalAlpha = 1
      for (const banana of visible) {
        drawSprite(context, sprite, banana, banana.angle, banana.r * 3.4)
      }
    }

    function finish() {
      window.removeEventListener('resize', resize)
      canvas.remove()
      unlockScroll()
      celebrating = false
    }

    function frame(now: number) {
      const dt = Math.min((now - lastFrame) / 1000, 1 / 20)
      lastFrame = now
      elapsed += dt
      phaseTime += dt

      if (phase === 'raining') {
        spawnBudget += spawnRate * Math.min(1, 0.3 + elapsed) * dt
        let pileTop = Infinity
        for (const banana of bananas) {
          if (banana.rest >= 1) {
            pileTop = Math.min(pileTop, banana.y - banana.r)
          }
        }
        while (spawnBudget >= 1 && bananas.length < maxBananas) {
          spawn(pileTop)
          spawnBudget--
        }
        if (isBuried() || phaseTime > 12) {
          phase = 'full'
          phaseTime = 0
          void playGameOver(sound).then(() => (soundFinished = true))
        }
      }
      if (phase === 'full' && soundFinished) {
        // the bottom of the bucket opens
        phase = 'draining'
        phaseTime = 0
        for (const banana of bananas) {
          banana.frozen = false
          banana.px = banana.x
          banana.py = banana.y
        }
      }

      accumulator += dt
      while (accumulator >= step) {
        simulate()
        accumulator -= step
      }
      draw()

      if (phase === 'draining' && (phaseTime > 5 || bananas.every((banana) => banana.y - banana.r * 2 > height))) {
        finish()
        return
      }
      requestAnimationFrame(frame)
    }

    requestAnimationFrame(frame)
  }

  trigger?.addEventListener('click', () => {
    const now = performance.now()
    clicks = now - lastClick <= maxClickGap ? clicks + 1 : 1
    lastClick = now
    if (clicks >= requiredClicks) {
      clicks = 0
      startBananaRain()
    }
  })
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 32px;
    font-size: 16px;
    color: var(--c-body);

    a {
      color: var(--c-strong);
      text-decoration: none;
      transition:
        color 0.2s,
        background-color 0.2s;
    }

    a:hover {
      color: var(--c-accent);
      cursor:
        url('/kela.svg') 5 7,
        pointer;
    }

    h1,
    h2,
    p {
      margin: 0;
    }
  }

  /* contact card button (the hero buttons are styled in Hero.astro) */
  .home .btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }

  .home .btn-primary {
    background: #4ade80;
    color: #0d1117;
  }

  .home .btn-primary:hover {
    background: #86efac;
    color: #0d1117;
  }

  @media (max-width: 639px) {
    .home .btn {
      justify-content: center;
      padding: 9px 10px;
    }
  }

  :global(.banana-rain) {
    position: fixed;
    z-index: 9999;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* bio */
  .bio {
    display: flex;
    flex-direction: column;
    gap: 24px;
    line-height: 1.75;
    text-wrap: pretty;

    a {
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--c-underline);
      text-underline-offset: 4px;
    }

    a:hover {
      color: var(--c-accent);
      text-decoration-color: currentColor;
    }
  }

  /* treks */
  .treks {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .treks :global(.trek-stats) {
    padding: 0 2px;
  }

  .map-container {
    aspect-ratio: 2 / 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--c-border-map);
    background: var(--c-map-bg);

    :global(.location-map) {
      height: 100%;
    }
  }

  /* work / projects / reading */
  .block {
    display: flex;
    flex-direction: column;
  }

  .block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    margin-bottom: 8px;
    border-top: 1px solid var(--c-border);

    h2 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--c-text);
    }
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-accent);
    background: var(--c-accent-tint);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
  }

  .home .more {
    font-size: 14px;
    font-weight: 500;
    color: var(--c-accent);
  }

  .home .more:hover {
    color: var(--c-accent-hover);
  }

  /* Rows (work, reading) and project cards share the same rhythm: 14px above
     and below, with a divider only between items, never after the last one,
     so it doesn't stack up against the next section's top border. */
  .row {
    display: grid;
