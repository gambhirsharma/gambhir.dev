---
const pdf = '/Ditch_Deck.pdf'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deck</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
      }
      object,
      embed,
      iframe {
        display: block;
        width: 100vw;
        height: 100vh;
        border: 0;
      }
    </style>
  </head>
  <body>
    <object data={pdf} type="application/pdf">
      <iframe src={pdf} title="Deck"></iframe>
    </object>
  </body>
</html>
