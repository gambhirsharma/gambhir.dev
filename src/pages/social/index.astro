---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import siteConfig from '@/site-config'

interface LinkRow {
  text: string
  icon: string
  display: string
  // no href renders a plain row, for handles without a public profile URL
  href?: string
}

// https://www.github.com/foo/ -> github.com/foo
const prettyUrl = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')

const socials: LinkRow[] = [
  ...siteConfig.socialLinks.map((l) => ({ text: l.text, href: l.href, icon: l.icon, display: prettyUrl(l.href) })),
  {
    text: 'CodePen',
    href: 'https://codepen.io/gambhirsharma',
    icon: 'i-simple-icons-codepen',
    display: 'codepen.io/gambhirsharma',
  },
  {
    text: 'Mastodon',
    href: 'https://mastodon.social/@gambhir',
    icon: 'i-simple-icons-mastodon',
    display: '@gambhir@mastodon.social',
  },
  {
    text: 'Bluesky',
    href: 'https://bsky.app/profile/gambhirsharma.bsky.social',
    icon: 'i-simple-icons-bluesky',
    display: 'gambhirsharma.bsky.social',
  },
  {
    text: 'Discord',
    icon: 'i-simple-icons-discord',
    display: 'gambhir_sharma',
  },
]

const emails: LinkRow[] = [
  {
    text: 'Email',
    href: `mailto:${siteConfig.email}`,
    icon: 'i-lucide-mail',
    display: siteConfig.email,
  },
  {
    text: 'Uni Email',
    href: 'mailto:gambhir.sharma@students.uniroma2.eu',
    icon: 'i-lucide-graduation-cap',
    display: 'gambhir.sharma@students.uniroma2.eu',
  },
]

const sections = [
  { title: 'find me', links: socials },
  { title: 'email', links: emails },
]
---

<BaseLayout title="Social" description="Where to find Gambhir Sharma online">
  <article class="social">
    <Hero />

    {
      sections.map((section, i) => (
        <section class:list={['block', { first: i === 0 }]}>
          <div class="block-head">
            <h2>{section.title}</h2>
          </div>
          {section.links.map((link) => {
            const external = link.href?.startsWith('http')
            const Tag = link.href ? 'a' : 'div'
            return (
              <Tag
                class="link-row"
                href={link.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <i class:list={[link.icon, 'link-icon']} aria-hidden="true" />
                <span class="link-label">{link.text}</span>
                <span class="link-handle">{link.display}</span>
                <span class="link-arrow" aria-hidden="true">
                  {link.href && (external ? '↗' : '→')}
                </span>
              </Tag>
            )
          })}
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .social {
    display: flex;
    flex-direction: column;
    gap: 32px;
    font-size: 16px;
    color: var(--c-body);

    h2 {
      margin: 0;
    }
  }

  .block {
    display: flex;
    flex-direction: column;
  }

  .block-head {
    padding-top: 20px;
    margin-bottom: 8px;
    border-top: 1px solid var(--c-border);

    h2 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--c-text);
    }
  }

  /* the hero already draws a line above the first section */
  .first .block-head {
    padding-top: 0;
    border-top: 0;
  }

  /* Same rhythm as the home page project cards: flat rows, 14px above and
     below, with an inset divider only between items. */
  .link-row {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) 14px;
    align-items: center;
    gap: 4px 12px;
    padding: 14px 12px;
    margin: 0 -12px;
    border-radius: 8px;
    color: var(--c-strong);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .link-row + .link-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    border-top: 1px solid var(--c-border-row);
    transition: opacity 0.2s;
  }

  a.link-row:hover {
    background: var(--c-hover-row);
    cursor:
      url('/kela.svg') 5 7,
      pointer;
  }

  a.link-row:hover::before,
  a.link-row:hover + .link-row::before {
    opacity: 0;
  }

  .link-icon {
    font-size: 18px;
    color: var(--c-accent);
  }

  .link-label {
    font-size: 17px;
    font-weight: 600;
    color: var(--c-strong);
    white-space: nowrap;
    transition: color 0.2s;
  }

  a.link-row:hover .link-label {
    color: var(--c-accent);
  }

  .link-handle {
    justify-self: end;
    text-align: right;
    font-size: 14px;
    color: var(--c-tertiary);
    overflow-wrap: anywhere;
  }

  .link-arrow {
    font-size: 14px;
    color: var(--c-tertiary);
    transition: color 0.2s;
  }

  a.link-row:hover .link-arrow {
    color: var(--c-accent);
  }

  /* Narrow screens: handle drops under the label instead of squeezing it */
  @media (max-width: 560px) {
    .link-row {
      grid-template-columns: auto minmax(0, 1fr) 14px;
      grid-template-areas:
        'icon label arrow'
        '. handle .';
    }

    .link-icon {
      grid-area: icon;
    }

    .link-label {
      grid-area: label;
    }

    .link-arrow {
      grid-area: arrow;
    }

    .link-handle {
      grid-area: handle;
      justify-self: start;
      text-align: left;
    }
  }
</style>
