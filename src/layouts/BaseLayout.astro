---
import { fade } from 'astro:transitions'
import { ViewTransitions } from 'astro:transitions'
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.vue'
import Footer from '@/components/Footer.vue'

const { ...head } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
    <ViewTransitions />
    <!-- Google tag (gtag.js), loaded on the main thread but only once the page is idle,
         so it never competes with first paint or island hydration. Calls made before
         gtag.js arrives are queued in dataLayer and flushed when it loads. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-TXR5YDK68S')

      if (!window.__gtagScheduled) {
        window.__gtagScheduled = true
        const loadGtag = () => {
          const s = document.createElement('script')
          s.async = true
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TXR5YDK68S'
          document.head.appendChild(s)
        }
        const whenIdle = () =>
          'requestIdleCallback' in window ? requestIdleCallback(loadGtag, { timeout: 4000 }) : setTimeout(loadGtag, 1500)
        if (document.readyState === 'complete') whenIdle()
        else addEventListener('load', whenIdle, { once: true })
      }
    </script>
  </head>
  <body class="bg-main text-main min-h-screen font-sans w-full bg-dot">
    <Header client:load currentPath={Astro.url.pathname} />
    <main
      class="grow max-w-3xl mx-auto sm:pt-36 pt-26 pb-16 px-6 relative"
      transition:animate={fade({ duration: '0.4s' })}
    >
      <slot />
      <Footer />
    </main>
  </body>
</html>
