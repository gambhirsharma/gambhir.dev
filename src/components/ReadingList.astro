---
import reading from '@/data/reading'
import type { ReadingItem } from '@/types'

const groups: Array<{ title: string; status: ReadingItem['status'] }> = [
  { title: 'reading', status: 'reading' },
  { title: 'read', status: 'read' },
  { title: 'to read', status: 'queued' },
]

const sections = groups
  .map((g) => ({ ...g, items: reading.filter((x) => x.status === g.status) }))
  .filter((g) => g.items.length > 0)
---

<div mb-12>
  {
    sections.map((s) => (
      <div mb-8>
        <h2 class="text-xs uppercase tracking-widest op-40 font-normal mb-4 select-none">{s.title}</h2>
        <ul>
          {s.items.map((x) => (
            <li mb-6>
              <a href={x.url} target="_blank" class="nav-link text-lg lh-tight">
                {x.title}
              </a>
              <div class="op-50 text-sm mt-1 flex gap-2 flex-wrap">
                <span>{[x.kind, x.authors, x.year, x.topic].filter(Boolean).join(' · ')}</span>
                {x.note && (
                  <a href={`/posts/${x.note}`} class="prose-link">
                    my notes →
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
