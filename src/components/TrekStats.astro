---
import type { TrekStats } from '@/data/treks'

interface Props {
  stats: TrekStats
  href?: string // makes the summary a link, e.g. to the treks page
}

const { stats, href } = Astro.props

const fmt = (n: number) => n.toLocaleString('en', { maximumFractionDigits: 1 })

const summary = [
  `${stats.count} ${stats.count === 1 ? 'trek' : 'treks'}`,
  `${fmt(stats.totalDistanceKm)} km walked`,
  `${fmt(stats.totalElevationGainM)} m climbed`,
  stats.highestPointM > 0 && `highest point ${fmt(stats.highestPointM)} m`,
]
  .filter(Boolean)
  .join(' · ')
---

{
  stats.count > 0 && (
    <p class="trek-stats">
      <i class="i-lucide-mountain" />
      {href ? (
        <a href={href} class="prose-link">
          {summary}
        </a>
      ) : (
        <span>{summary}</span>
      )}
    </p>
  )
}

<style>
  .trek-stats {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: -0.5rem 0 1.5rem;
    font-size: 0.9rem;
    line-height: 1.5;

    /* keep the mountain icon on the first line, next to the text */
    i {
      flex: none;
      margin-top: 0.15em;
    }

    /* On the home page this sits inside .prose, where .prose a applies the
       `prose-link` shortcut (text-nowrap). The summary is long enough to
       overflow narrow screens, so let it wrap and break long tokens. */
    a,
    span {
      min-width: 0;
      white-space: normal;
      overflow-wrap: anywhere;
      text-wrap: pretty;
    }
  }
</style>
