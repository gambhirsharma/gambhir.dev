---
import type { TrekStats } from '@/data/treks'

interface Props {
  stats: TrekStats
  href?: string // makes the summary a link, e.g. to the treks page
}

const { stats, href } = Astro.props

const fmt = (n: number) => n.toLocaleString('en', { maximumFractionDigits: 1 })

const summary = [
  `${stats.count} ${stats.count === 1 ? 'trek' : 'treks'}`,
  `${fmt(stats.totalDistanceKm)} km walked`,
  `${fmt(stats.totalElevationGainM)} m climbed`,
  stats.highestPointM > 0 && `highest point ${fmt(stats.highestPointM)} m`,
]
  .filter(Boolean)
  .join(' · ')
---

{
  stats.count > 0 && (
    <p class="trek-stats">
      <i class="i-lucide-mountain" />
      <span class="trek-summary">
        {href ? (
          <a href={href} class="prose-link">
            {summary}
          </a>
        ) : (
          summary
        )}
      </span>
    </p>
  )
}

<style>
  .trek-stats {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: -0.5rem 0 1.5rem;
    font-size: 0.9rem;
    line-height: 1.5;

    /* keep the mountain icon on the first line, next to the text */
    i {
      flex: none;
      margin-top: 0.15em;
    }

    /* The wrapper is the flex item, so it can shrink and wrap. The link
       inside stays an inline box: that way its border-bottom underline is
       painted under every wrapped line, not just under the last one. */
    .trek-summary {
      min-width: 0;
      overflow-wrap: anywhere;
      text-wrap: pretty;
    }

    /* On the home page this sits inside .prose, where .prose a applies the
       `prose-link` shortcut (text-nowrap), so allow the text to wrap. */
    a {
      white-space: normal;
    }
  }
</style>
