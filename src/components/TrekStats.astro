---
import type { TrekStats } from '@/data/treks'

interface Props {
  stats: TrekStats
  href?: string // makes the summary a link, e.g. to the treks page
}

const { stats, href } = Astro.props

const fmt = (n: number) => n.toLocaleString('en', { maximumFractionDigits: 1 })

// Each item is [before, value, after], the value is the highlighted part
const items: Array<[string, string, string]> = [
  ['', `${stats.count}`, stats.count === 1 ? ' trek' : ' treks'],
  ['', `${fmt(stats.totalDistanceKm)} km`, ' walked'],
  ['', `${fmt(stats.totalElevationGainM)} m`, ' climbed'],
]
if (stats.highestPointM > 0) items.push(['highest ', `${fmt(stats.highestPointM)} m`, ''])

const Tag = href ? 'a' : 'p'
---

{
  stats.count > 0 && (
    <Tag class="trek-stats" href={href}>
      <i class="i-lucide-mountain" />
      {items.map(([before, value, after], i) => (
        <>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              ·
            </span>
          )}
          <span>
            {before}
            <b>{value}</b>
            {after}
          </span>
        </>
      ))}
    </Tag>
  )
}

<style>
  .trek-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-secondary);
    text-decoration: none;
    transition: color 0.2s;

    i {
      flex: none;
      width: 15px;
      height: 15px;
    }

    b {
      font-weight: 600;
      color: var(--c-strong);
    }

    .sep {
      opacity: 0.4;
    }
  }

  a.trek-stats:hover {
    color: var(--c-stat-hover);
  }
</style>
